<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar">
        <a href="/" class="brand">AuthSystem</a>
        <div class="nav-links">
            <a href="/login">Login</a>
            <a href="/register">Register</a>
        </div>
    </nav>

    <div class="form-container">
        <h2>Reset Password</h2>

        <% if (error) { %>
            <div class="error-msg"><%= error %></div>
        <% } %>

        <form action="/reset-password/<%= token %>" method="POST" id="resetForm">
            <div class="form-group">
                <label for="password">New Password</label>
                <div class="password-wrapper">
                    <input type="password" id="password" name="password" placeholder="Min 6 characters" required minlength="6">
                    <button type="button" class="toggle-password" onclick="togglePass('password')">Show</button>
                </div>
            </div>

            <div class="form-group">
                <label for="confirmPassword">Confirm New Password</label>
                <div class="password-wrapper">
                    <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Re-enter password" required>
                    <button type="button" class="toggle-password" onclick="togglePass('confirmPassword')">Show</button>
                </div>
            </div>

            <button type="submit" class="btn">Reset Password</button>
        </form>

        <div class="form-footer">
            <p><a href="/login">Back to Login</a></p>
        </div>
    </div>

    <script>
        function togglePass(fieldId) {
            var field = document.getElementById(fieldId);
            var btn = field.parentElement.querySelector('.toggle-password');
            if (field.type === "password") {
                field.type = "text";
                btn.textContent = "Hide";
            } else {
                field.type = "password";
                btn.textContent = "Show";
            }
        }

        document.getElementById("resetForm").addEventListener("submit", function(e) {
            var password = document.getElementById("password").value;
            var confirmPassword = document.getElementById("confirmPassword").value;

            if (password !== confirmPassword) {
                e.preventDefault();
                alert("Passwords do not match!");
            }
        });
    </script>
</body>
</html>
